program vitruvio_sncscan

%{
#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
#include <unistd.h>
#include <time.h>
#include <sys/stat.h>
#include <errno.h>
#include "vitruvio_utils.h"
#include <epicsThread.h>

#define MAX_MOTORS 20
#define MAX_DETECTORS 20
#define MOTOR_TOLERANCE 0.1    /* mm - tolleranza posizione motore */
#define MOTOR_TIMEOUT   20      /* cicli max senza movimento prima di rimandare comando */

//File di Summary
static FILE *summary_file;
static char general_path_save_file[512];

//File Generali di scan per detector
static FILE *detector_files[MAX_DETECTORS];
static char detector_paths[MAX_DETECTORS][512];

//File Salvataggio detector
static FILE *data_files[MAX_DETECTORS];
static char data_paths[MAX_DETECTORS][512];

}%

/*=================== Declarations =========================*/

option +r;

//	Output Configuration Files
string output_path; assign output_path to "{user}:scan:filepath"; monitor output_path;
int num_files_open;
string session; assign session to "{user}:scan:session"; monitor session;

string sum_file[60]; assign sum_file to "{user}:scan_file"; monitor sum_file;
string files_out[20]; assign files_out to "{user}:filename"; monitor files_out;
string data_out[20]; assign data_out to {}; monitor data_out;
string detector_filepath[20]; assign detector_filepath to {}; monitor detector_filepath;

char full_save_path[80];
char general_save_file[90];
string name_exp[40];

string name_server; assign name_server to "{user}:server:name"; monitor name_server;
string name_exp_pv; assign name_exp_pv to "{user}:experiment"; monitor name_exp_pv;

// General Scan Configuration
int status_mode; assign status_mode to "{user}:status"; monitor status_mode;
string actual_status[80]; assign actual_status to "{user}:state"; monitor actual_status;
char local_actual_status[80];

int scan_busy; assign scan_busy to "{user}:scan_busy"; monitor scan_busy;
int scan_pause; assign scan_pause to "{user}:scan_pause"; monitor scan_pause;
int scan_restart; assign scan_restart to "{user}:scan_restart"; monitor scan_restart;
int scan_abort; assign scan_abort to "{user}:scan_abort"; monitor scan_abort;
int end_scan; assign end_scan to "{user}:end_scan"; monitor end_scan;

// Scan Parameters
int num_mot; assign num_mot to "{user}:num_motor"; monitor num_mot;
int num_det; assign num_det to "{user}:num_detector"; monitor num_det;

double start[20]; assign start to "{user}:start"; monitor start;
double end[20]; assign end to "{user}:end"; monitor end;
double step[20]; assign step to "{user}:step"; monitor step;
int npoints[20]; assign npoints to "{user}:num_steps"; monitor npoints;
int steps;

double posit[20];
int index[20];

int total_points; assign total_points to "{user}:total_points"; monitor total_points;
int current_point; assign current_point to "{user}:current_point"; monitor current_point;
double scan_progress; assign scan_progress to "{user}:scan_progress"; monitor scan_progress;

int flags[20];

// Motors
string motor[20]; assign motor to "{user}:motor"; monitor motor;
string mot_command[7]; assign mot_command to "{user}:motor_command"; monitor mot_command;

// Detectors
string detector[20]; assign detector to "{user}:detector"; monitor detector;
string det_command[9]; assign det_command to "{user}:detector_command"; monitor det_command;

double motget; assign motget to ""; monitor motget;
double motset; assign motset to ""; monitor motset;
double detget; assign detget to ""; monitor detget;
double detset; assign detset to ""; monitor detset;

double pos;
double mov_wait;
double acq_wait;

double motor_mr[20]; assign motor_mr to {}; monitor motor_mr;
double motor_ma[20]; assign motor_ma to {}; monitor motor_ma;
int motor_reqmov[20]; assign motor_reqmov to {}; monitor motor_reqmov;
int motor_mov[20]; assign motor_mov to {}; monitor motor_mov;
int motor_reqpos[20]; assign motor_reqpos to {}; monitor motor_reqpos;
double motor_pos[20]; assign motor_pos to {}; monitor motor_pos;
int motor_status[20]; assign motor_status to {}; monitor motor_status;

int detector_reqstart[20]; assign detector_reqstart to {}; monitor detector_reqstart;
int detector_reqready[20]; assign detector_reqready to {}; monitor detector_reqready;
int detector_ready[20]; assign detector_ready to {}; monitor detector_ready;
int detector_reqdata[20]; assign detector_reqdata to {}; monitor detector_reqdata;
double detector_data[20]; assign detector_data to {}; monitor detector_data;
int detector_type[20]; assign detector_type to{}; monitor detector_type;
int detector_status[20]; assign detector_status to {}; monitor detector_status;

int i;
int j;
int k;
int d;
int allready;
int command;
char temp_string[80];
char temp_status[80];
char temp_exp[40];
int all_connected;
int checkbusy;
int busyioc;
int timeout_count[20];      /* contatore timeout per ogni motore */
double last_pos[20];        /* ultima posizione letta per rilevare stallo */

ss scan_status_mode {
/*=================== Start Program =========================*/
	state init {
		when (status_mode==0) {
			pvGet(name_exp_pv,SYNC);
			if (scan_busy==0) {
				printf("****************************\n");
				printf("********* ERROR!!! *********\n");
				printf("***    Exp %s is busy    ***\n", name_exp_pv);
				printf("****************************\n");
				strcpy(actual_status,local_actual_status);
				sprintf(actual_status, "Exp %s busy", name_exp_pv);
			} else {
				printf("**********************\n");
				printf("*** Ready for Scan ***\n");
				printf("***    Exp %s    ***\n", name_exp_pv);
				printf("**********************\n");
				sprintf(local_actual_status, "Starting Scan %s", name_exp_pv);
				strcpy(actual_status,local_actual_status);
				pvPut(actual_status,SYNC);
			}
		} state idle
	}
	state idle {
		when (status_mode==1) {
			printf("\n********************\n");
			printf("*** Assign Motor ***\n");
			printf("********************\n");
		} state assign_motor
		when (status_mode==2) {
			printf("\n***********************\n");
			printf("*** Assign Detector ***\n");
			printf("***********************\n");
		} state assign_detector
		when (status_mode==3) {
			printf("\n***************************\n");
			printf("*** Initialization Loop ***\n");
			printf("***************************\n");
		} state init_loop
		when (status_mode==4) {
			printf("\n*******************\n");
			printf("*** Connecting PV **\n");
			printf(" *******************\n");
		} state wait_connect
		when (status_mode==5) {
			printf("\n********************\n");
			printf("*** Prepare Loop ***\n");
			printf("********************\n");
		} state prepare_loop
		when (status_mode==6) {
			printf("\n******************\n");
			printf("*** Loop ***\n");
			printf("******************\n");
		} state loop
	}

/*=================== Assign Motor =========================*/
	state assign_motor {
		when () {
			pvGet(motor, SYNC);
			pvGet(mot_command, SYNC);
			printf("num_mot = %d\n", num_mot);
			for (i = 0; i < num_mot; i++) {
				printf("index = %d\n", i);
				command=0;
				sprintf(temp_string, "%s:%s", motor[i], mot_command[command]);
				pvAssign(motor_mr[i],temp_string);
				command=1;
				sprintf(temp_string, "%s:%s", motor[i], mot_command[command]);
				pvAssign(motor_ma[i],temp_string);
				command=2;
				sprintf(temp_string, "%s:%s", motor[i], mot_command[command]);
				pvAssign(motor_reqmov[i],temp_string);
				command=3;
				sprintf(temp_string, "%s:%s", motor[i], mot_command[command]);
				pvAssign(motor_mov[i],temp_string);
				command=4;
				sprintf(temp_string, "%s:%s", motor[i], mot_command[command]);
				pvAssign(motor_reqpos[i],temp_string);
				command=5;
				sprintf(temp_string, "%s:%s", motor[i], mot_command[command]);
				pvAssign(motor_pos[i],temp_string);
				command=6;
				sprintf(temp_string, "%s:%s", motor[i], mot_command[command]);
				pvAssign(motor_status[i],temp_string);
			}
			strcpy(local_actual_status, "Motors Parameters Assigned - Status 1");
			strcpy(actual_status,local_actual_status);
			pvPut(actual_status,SYNC);
			status_mode=0;
			pvPut(status_mode,SYNC);
		} state idle
	}

/*=================== Assign Detector =========================*/
	state assign_detector {
		when () {
			pvGet(detector, SYNC);
			pvGet(det_command, SYNC);
			printf("num_det = %d\n", num_det);
			for (i = 0; i < num_det; i++) {
				printf("index = %d\n", i);
				command=0;
				sprintf(temp_string, "%s:%s", detector[i], det_command[command]);
				pvAssign(detector_reqstart[i],temp_string);
				command=1;
				sprintf(temp_string, "%s:%s", detector[i], det_command[command]);
				pvAssign(detector_reqdata[i],temp_string);
				command=2;
				sprintf(temp_string, "%s:%s", detector[i], det_command[command]);
				pvAssign(detector_data[i],temp_string);
				command=3;
				sprintf(temp_string, "%s:%s", detector[i], det_command[command]);
				pvAssign(detector_reqready[i],temp_string);
				command=4;
				sprintf(temp_string, "%s:%s", detector[i], det_command[command]);
				pvAssign(detector_ready[i],temp_string);
				command=5;
				sprintf(temp_string, "%s:%s", detector[i], det_command[command]);
				pvAssign(detector_type[i],temp_string);
				command=6;
				sprintf(temp_string, "%s:%s", detector[i], det_command[command]);
				pvAssign(detector_status[i],temp_string);
				command=7;
				sprintf(temp_string, "%s:%s", detector[i], det_command[command]);
				pvAssign(data_out[i],temp_string);
				command=8;
				sprintf(temp_string, "%s:%s", detector[i], det_command[command]);
				pvAssign(detector_filepath[i],temp_string);
			}
			strcpy(local_actual_status, "Detect. Parameters Assigned - Status 2");
			strcpy(actual_status,local_actual_status);
			pvPut(actual_status,SYNC);
			status_mode=0;
			pvPut(status_mode,SYNC);
		} state idle
	}

/*=================== Initialize Loop =========================*/
	state init_loop {
		when() {
			end_scan=1;
			pvPut(end_scan,SYNC);
			total_points = 1;
			for (i = 0; i < num_mot; i++) {
				flags[i]=0;
				posit[i]=start[i];
				index[i]=0;
				npoints[i] = ( (end[i]-start[i]) / step[i] ) + 1;
				printf("the number steps for motor %d is %d\n", i, npoints[i]);
				total_points *= npoints[i];
			}
			printf("the total step number is %d\n", total_points);
			pvPut(npoints,SYNC);
			pvPut(total_points,SYNC);
			current_point=0;
			pvPut(current_point,SYNC);
			scan_busy=1;
			pvPut(scan_busy,SYNC);
			scan_restart=0;
			pvPut(scan_restart,SYNC);
			scan_pause=0;
			pvPut(scan_pause,SYNC);
			scan_abort=0;
			pvPut(scan_abort,SYNC);
		} state check_init
	}

	state check_init {
		when() {
			checkbusy=0;
			for (i = 0; i < num_mot; i++) {
				if (motor_status[i]!=1) checkbusy++;
			}
			for (i = 0; i < num_det; i++) {
				if (detector_status[i]!=1) checkbusy++;
			}
		} state ifbusy
	}

	state ifbusy {
		when(checkbusy==0) {
		} state end_init
		when(checkbusy!=0) {
			printf("At least one IOC is busy\n");
		} state error_busy
	}

	state end_init{
		when() {
			pvPut(total_points,SYNC);
			current_point=0;
			pvPut(current_point,SYNC);
			scan_busy=1;
			pvPut(scan_busy,SYNC);
			scan_restart=0;
			pvPut(scan_restart,SYNC);
			scan_pause=0;
			pvPut(scan_pause,SYNC);
			scan_abort=0;
			pvPut(scan_abort,SYNC);
			strcpy(local_actual_status, "Scan Initialized - Status 3");
			strcpy(actual_status,local_actual_status);
			pvPut(actual_status,SYNC);
			status_mode=0;
			pvPut(status_mode,SYNC);
		} state idle
	}

/*=================== Connecting PV =========================*/
	state wait_connect {
		when () {
			all_connected = 1;
			for (i = 0; i < num_mot; i++) {
				if (!pvConnected(motor_mr[i]))    { all_connected=0; printf("Motor %d motor_mr not connected\n",i); }
				if (!pvConnected(motor_ma[i]))    { all_connected=0; printf("Motor %d motor_ma not connected\n",i); }
				if (!pvConnected(motor_reqmov[i])){ all_connected=0; printf("Motor %d motor_reqmov not connected\n",i); }
				if (!pvConnected(motor_mov[i]))   { all_connected=0; printf("Motor %d motor_mov not connected\n",i); }
				if (!pvConnected(motor_reqpos[i])){ all_connected=0; printf("Motor %d motor_reqpos not connected\n",i); }
				if (!pvConnected(motor_pos[i]))   { all_connected=0; printf("Motor %d motor_pos not connected\n",i); }
				if (!pvConnected(motor_status[i])){ all_connected=0; printf("Motor %d motor_status not connected\n",i); }
			}
			for (i = 0; i < num_det; i++) {
				if (!pvConnected(detector_reqstart[i])) { all_connected=0; printf("Detector %d reqstart not connected\n",i); }
				if (!pvConnected(detector_reqdata[i]))  { all_connected=0; printf("Detector %d reqdata not connected\n",i); }
				if (!pvConnected(detector_data[i]))     { all_connected=0; printf("Detector %d data not connected\n",i); }
				if (!pvConnected(detector_reqready[i])) { all_connected=0; printf("Detector %d reqready not connected\n",i); }
				if (!pvConnected(detector_ready[i]))    { all_connected=0; printf("Detector %d ready not connected\n",i); }
				if (!pvConnected(detector_type[i]))     { all_connected=0; printf("Detector %d type not connected\n",i); }
				if (!pvConnected(detector_status[i]))   { all_connected=0; printf("Detector %d status not connected\n",i); }
				if (!pvConnected(data_out[i]))          { all_connected=0; printf("Detector %d data_out not connected\n",i); }
				if (!pvConnected(detector_filepath[i])) { all_connected=0; printf("Detector %d filepath not connected\n",i); }
			}
			if (all_connected==1) {
				printf("All PVs are connected!\n");
				strcpy(local_actual_status, "PV Connected - Status 4");
			} else {
				printf("All PVs are NOT connected!\n");
				strcpy(local_actual_status, "Error in PV Connection - Status 4");
			}
			strcpy(actual_status,local_actual_status);
			pvPut(actual_status,SYNC);
			status_mode=0;
			pvPut(status_mode,SYNC);
		} state idle
	}

/*=================== Preparing Scan =========================*/
	state prepare_loop {
		when () {
			strcpy(local_actual_status, "Preparing Loop - Status 5");
			strcpy(actual_status,local_actual_status);
			pvPut(actual_status,SYNC);
			scan_busy=0;
			pvPut(scan_busy,SYNC);
			for (i = 0; i < num_mot; i++) {
				motor_status[i]=0;
				pvPut(motor_status[i],SYNC);
			}
			for (i = 0; i < num_det; i++) {
				detector_status[i]=0;
				pvPut(detector_status[i],SYNC);
			}
//
//	Move motors to start position
//
			for (i = 0; i < num_mot; i++) {
				printf("motor to move = %d\n", i);
				printf("start[%d]= %f\n", i, start[i]);
				motor_ma[i]=start[i];
				pvPut(motor_ma[i],SYNC);
				motor_reqmov[i]=1;
				pvPut(motor_reqmov[i],SYNC);
				pvGet(motor_mov[i],SYNC);
				timeout_count[i] = 0;
				last_pos[i] = motor_pos[i];
			}
			allready = 0;
		} state prepare_waiting_ready
	}

//
//	Attesa che tutti i motori arrivino alla posizione iniziale (start)
//	Usa posizione reale come indicatore — non motor_mov che non è affidabile
//
	state prepare_waiting_ready {
		when (allready==num_mot) {
			allready = 0;
			for (i = 0; i < num_mot; i++) {
				motor_reqpos[i]=1;
				pvPut(motor_reqpos[i],SYNC);
				epicsThreadSleep(0.2);
				pvGet(motor_pos[i], SYNC);
				printf("Motor %d at start: pos=%.3f (target=%.3f)\n", i, motor_pos[i], start[i]);
				posit[i] = start[i];
				index[i] = 0;
				timeout_count[i] = 0;
			}
			flags[0]=1;
			strcpy(local_actual_status, "Ready to Start - status 5");
			strcpy(actual_status,local_actual_status);
			pvPut(actual_status,SYNC);
			status_mode=6;
			pvPut(status_mode,SYNC);
		} state open_file
		when () {
			allready = 0;
			for (j=0; j < num_mot; j++) {
				epicsThreadSleep(0.3);
				motor_reqpos[j]=1;
				pvPut(motor_reqpos[j],SYNC);
				epicsThreadSleep(0.2);
				pvGet(motor_pos[j],SYNC);
				if (fabs(motor_pos[j] - start[j]) < MOTOR_TOLERANCE) {
					allready++;
				} else {
//	Controlla se il motore è in stallo (posizione non cambia)
					if (fabs(motor_pos[j] - last_pos[j]) < 0.001) {
						timeout_count[j]++;
						if (timeout_count[j] > MOTOR_TIMEOUT) {
							printf("WARNING: Motor %d stalled at %.3f, resending to %.3f\n",
								j, motor_pos[j], start[j]);
							motor_ma[j]=start[j];
							pvPut(motor_ma[j],SYNC);
							motor_reqmov[j]=1;
							pvPut(motor_reqmov[j],SYNC);
							timeout_count[j] = 0;
						}
					} else {
						timeout_count[j] = 0;
					}
					last_pos[j] = motor_pos[j];
				}
			}
		} state prepare_waiting_ready
	}

//
//	Preparing General Save Files
//
	state open_file {
		when() {
%{
			char timestamp[64];
			time_t now;
			struct tm *tm_info;
}%
			num_files_open = 0;
			for (i = 0; i < MAX_DETECTORS; i++) {
				detector_files[i] = NULL;
			}
			time(&now);
			tm_info = localtime(&now);
			strftime(timestamp, sizeof(timestamp), "%Y%m%d_%H%M%S", tm_info);
//
			create_session_path(full_save_path, sizeof(full_save_path), name_server, output_path, session);
//
			generate_general_filename(general_path_save_file, sizeof(general_path_save_file), general_save_file, sizeof(general_save_file), full_save_path, name_exp_pv);
//
			for (i = 0; i < num_det; i++) {
				sprintf(detector_filepath[i], "%s/%s", output_path, session);
				pvPut(detector_filepath[i], SYNC);
			}
//
			strcpy(sum_file,general_save_file);
			pvPut(sum_file,SYNC);
//
			printf("Summary File: %s\n", general_path_save_file);
			summary_file = fopen(general_path_save_file, "w");
			if (summary_file == NULL) {
				printf("Scan: ERROR - Cannot open file %s: %s\n", general_path_save_file, strerror(errno));
			} else {
				fprintf(summary_file, "# Raster Scan Data - Summary\n");
				fprintf(summary_file, "# Timestamp: %s\n", timestamp);
				fprintf(summary_file, "# Number of motors: %d\n", num_mot);
				for (i = 0; i < num_mot; i++ ) {
					fprintf(summary_file, "# Range Motor[%d]: start[%d] = %f, end[%d] = %f, step[%d] = %f\n", i, i, start[i], i, end[i], i, step[i]);
				}
				fprintf(summary_file, "# Number of detectors: %d\n", num_det);
				for (i = 0; i < num_det; i++ ) {
					for (j = 0; j < num_mot; j++) {
						fprintf(summary_file, "Motor %d: %s \t", j+1, motor[j]);
					}
					fprintf(summary_file, "Detector %d: %s \n", i+1, detector[i]);
				}
				fflush(summary_file);
			}
//
			num_files_open = 0;
			for (i = 0; i < num_det; i++) {
				snprintf(files_out[i], sizeof(files_out[i]),"%s_%s_%s.dat", name_exp_pv, detector[i], timestamp);
				snprintf(detector_paths[i], sizeof(detector_paths[i]),"%s/%s", full_save_path, files_out[i]);
				detector_files[i] = fopen(detector_paths[i], "w");
				printf("Scan: Opening file for Detector %i: %s\n", i+1, detector_paths[i]);
				if (detector_files[i] == NULL) {
					printf("Scan: ERROR - Cannot open file %s: %s\n", detector_paths[i], strerror(errno));
				} else {
					num_files_open++;
					fprintf(detector_files[i], "# Raster Scan Data - Detector %d\n", i+1);
					fprintf(detector_files[i], "# Timestamp: %s\n", timestamp);
					fprintf(detector_files[i], "# Number of motors: %d\n", num_mot);
					fprintf(detector_files[i], "# Columns: ");
					for (j = 0; j < num_mot; j++) {
						fprintf(detector_files[i], "Data Motor%d\t Real Motor%d\t", j+1, j+1);
					}
					fprintf(detector_files[i], "Detector%d\n", i+1);
					fflush(detector_files[i]);
				}
			}
			pvPut(files_out,SYNC);
			if (num_files_open == 0) {
				printf("Scan: ERROR - No files opened! Check path and permissions\n");
			}
		} state loop
	}

/*====================== Loop ============================*/
	state loop {
		when(scan_abort==1) {
			printf("Scan Aborted by User\n");
		} state abort_scan
		when() {
			strcpy(local_actual_status, "Loop - Status 6");
			strcpy(actual_status,local_actual_status);
			pvPut(actual_status,SYNC);
		} state loops
	}

	state loops {
		when() {
		} state acquiring
	}

// Acquisizione nella posizione corrente
	state acquiring {
		when (end_scan==0) {
		} state ending
		when () {
			for (j=0; j < num_det; j++) {
				for (k=0; k<num_mot; k++) {
					fprintf(detector_files[j], "%.3f\t%.3f\t", motor_ma[k], motor_pos[k]);
				}
			}
			for (j=0; j < num_det; j++) {
				detector_reqstart[j]=1;
				pvPut(detector_reqstart[j],SYNC);
			}
		} state waiting_ready
	}

// Attesa fine acquisizione
	state waiting_ready {
		when (allready==num_det) {
			allready = 0;
		} state saving_data
		when () {
			allready = 0;
			for (j=0; j < num_det; j++) {
				detector_reqready[j]=1;
				pvPut(detector_reqready[j],SYNC);
				epicsThreadSleep(0.5);
				pvGet(detector_ready[j],SYNC);
				if (detector_ready[j]>0) {
					allready++;
				}
				epicsThreadSleep(1.0);
			}
		} state waiting_ready
	}

// Salvataggio dati
	state saving_data {
		when () {
			for (j=0; j < num_det; j++) {
				if (detector_type[j] == 1) {
					pvGet(detector_data[j],SYNC);
					fprintf(detector_files[j], "%.0f\n", detector_data[j]);
					fflush(detector_files[j]);
				} else if (detector_type[j] == 2) {
					generate_filename_with_time(data_paths[j], sizeof(data_paths[j]), data_out[j], sizeof(data_out[j]), full_save_path, name_exp_pv, detector[j], current_point);
					pvPut(data_out[j],SYNC);
//					fprintf(detector_files[j], "%s\n", data_paths[j]);
					fprintf(detector_files[j], "%s\n", data_out[j]);
					fflush(detector_files[j]);
				}
			}
			current_point++;
			pvPut(current_point,SYNC);
			scan_progress=100*current_point/total_points;
			pvPut(scan_progress,SYNC);
			printf("Actual Step = %d,  Progress = %f\n",current_point,scan_progress);
		} state positions
	}

// Calcolo prossima posizione
	state positions {
		when() {
			for (i=0; i<num_mot; i++) {
				if (flags[i] == 1) {
					if (index[i]==npoints[i]-1) {
						flags[i]=2;
						posit[i]=start[i];
						index[i]=0;
					} else {
						posit[i]=step[i]+posit[i];
						index[i]=index[i]+1;
					}
					printf("step=%d, i=%d, flag[%d]=%d, posit[%d]=%f, index[%d]=%d\n",
						current_point, i, i, flags[i], i, posit[i], i, index[i]);
					if (flags[i] == 2 && i == num_mot-1) {
						end_scan=0;
						pvPut(end_scan,SYNC);
					} else if (flags[i] == 2) {
						flags[i+1]=1;
					}
				}
			}
		} state moving
	}

// Invio comandi di movimento
	state moving {
		when(scan_abort==1) {
			printf("Scan Aborted by User\n");
		} state abort_scan
		when(scan_pause==1) {
			printf("Scan Paused by User\n");
		} state pause_scan
		when() {
			for (i = 0; i < num_mot; i++) {
				if (posit[i] != motor_pos[i]) {
					motor_ma[i]=posit[i];
					pvPut(motor_ma[i],SYNC);
					motor_reqmov[i]=1;
					pvPut(motor_reqmov[i],SYNC);
					pvGet(motor_mov[i],SYNC);
				}
				timeout_count[i] = 0;
				last_pos[i] = motor_pos[i];
			}
			allready = 0;
		} state motor_waiting_ready
	}

//
//	Attesa fine movimento — usa posizione reale, non motor_mov
//	Sequenziale: aspetta motore 0, poi 1, poi 2, ecc.
//
	state motor_waiting_ready {
		when(scan_abort==1) {
			printf("Scan Aborted by User\n");
		} state abort_scan
		when(scan_pause==1) {
			printf("Scan Paused by User\n");
		} state pause_scan
		when (allready==num_mot) {
			allready = 0;
//	Leggi posizione reale finale di tutti i motori
			for (i = 0; i < num_mot; i++) {
				motor_reqpos[i]=1;
				pvPut(motor_reqpos[i],SYNC);
				epicsThreadSleep(0.2);
				pvGet(motor_pos[i], SYNC);
				printf("current_point=%d posit[%d]=%.3f motor_pos[%d]=%.3f\n",
					current_point, i, posit[i], i, motor_pos[i]);
			}
//	Reset flags per il prossimo ciclo
			for(i=0; i<num_mot; i++) {
				flags[i]=0;
			}
			flags[0]=1;
		} state loops
		when () {
			allready = 0;
			for (j=0; j < num_mot; j++) {
				epicsThreadSleep(0.3);
				motor_reqpos[j]=1;
				pvPut(motor_reqpos[j],SYNC);
				epicsThreadSleep(0.2);
				pvGet(motor_pos[j],SYNC);
				if (fabs(motor_pos[j] - posit[j]) < MOTOR_TOLERANCE) {
					allready++;
				} else {
//	Controlla stallo — se posizione non cambia rimanda comando
					if (fabs(motor_pos[j] - last_pos[j]) < 0.001) {
						timeout_count[j]++;
						if (timeout_count[j] > MOTOR_TIMEOUT) {
							printf("WARNING: Motor %d stalled at %.3f, resending to %.3f\n",
								j, motor_pos[j], posit[j]);
							motor_ma[j]=posit[j];
							pvPut(motor_ma[j],SYNC);
							motor_reqmov[j]=1;
							pvPut(motor_reqmov[j],SYNC);
							timeout_count[j] = 0;
						}
					} else {
						timeout_count[j] = 0;
					}
					last_pos[j] = motor_pos[j];
				}
			}
		} state motor_waiting_ready
	}

/*=================== End Scan =========================*/
	state ending {
		when() {
			for (i = 0; i < num_mot; i++) {
				motor_status[i]=1;
				pvPut(motor_status[i],SYNC);
			}
			for (i = 0; i < num_det; i++) {
				detector_status[i]=1;
				pvPut(detector_status[i],SYNC);
			}
			printf("\n****************\n");
			printf("*** End Scan ***\n");
			printf("****************\n");
			strcpy(local_actual_status, "Loop End - Status 6");
			strcpy(actual_status,local_actual_status);
			pvPut(actual_status,SYNC);
			scan_busy=1;
			pvPut(scan_busy,SYNC);
			current_point = 0;
			pvPut(current_point,SYNC);
			scan_progress = 0;
			pvPut(scan_progress,SYNC);
			end_scan=1;
			pvPut(end_scan,SYNC);
			status_mode=0;
			pvPut(status_mode,SYNC);
		} state close_file
	}

/*=================== Abort Scan =========================*/
	state abort_scan {
		when () {
			for (i = 0; i < num_mot; i++) {
				motor_status[i]=1;
				pvPut(motor_status[i],SYNC);
			}
			for (i = 0; i < num_det; i++) {
				detector_status[i]=1;
				pvPut(detector_status[i],SYNC);
			}
			printf("rasterScan: Cleaning up after abort\n");
			scan_busy=1;
			pvPut(scan_busy,SYNC);
			current_point = 0;
			pvPut(current_point,SYNC);
			scan_progress = 0;
			pvPut(scan_progress,SYNC);
			scan_abort = 0;
			pvPut(scan_abort,SYNC);
			end_scan=1;
			pvPut(end_scan,SYNC);
			status_mode=0;
			pvPut(status_mode,SYNC);
		} state close_file
	}

/*=================== Close File =========================*/
	state close_file {
		when () {
			if (summary_file != NULL) {
				fclose(summary_file);
				summary_file=NULL;
				printf("Scan: Closed summary file: %s\n", general_path_save_file);
			}
			for (i = 0; i < num_det; i++) {
				if (detector_files[i] != NULL) {
					fclose(detector_files[i]);
					detector_files[i] = NULL;
					printf("Scan: Closed file: %s\n", detector_paths[i]);
				}
			}
			num_files_open = 0;
			printf("Scan: All files closed\n");
		} state idle
	}

/*=================== Pause =========================*/
	state pause_scan {
		when(scan_abort==1) {
			printf("Scan Aborted by User\n");
		} state abort_scan
		when (scan_restart==1) {
			scan_pause = 0;
			pvPut(scan_pause,SYNC);
		} state moving
		when () {
			pvGet(scan_restart,SYNC);
			epicsThreadSleep(0.5);
		} state pause_scan
	}

/*=================== Error States =========================*/
	state error_connect {
		when () {
			printf("System in error state - Check PV connections\n");
			strcpy(local_actual_status, "Error PV Connection - Status 4");
			strcpy(actual_status,local_actual_status);
			pvPut(actual_status,SYNC);
			status_mode=0;
			pvPut(status_mode,SYNC);
		} state idle
	}

	state error_busy {
		when () {
			printf("System in error state - Busy IOCs\n");
			strcpy(local_actual_status, "IOCs busy - Status 3");
			strcpy(actual_status,local_actual_status);
			pvPut(actual_status,SYNC);
			status_mode=0;
			pvPut(status_mode,SYNC);
		} state idle
	}

}
